{# Every icon is inline SVG and every link is conditional: an empty or missing
   value in site.links simply drops that icon. No CDN, no icon font, no runtime
   requests. Add a handle by filling in its key in src/_data/site.json. #}
<div class="social-icons">
  {% if site.links.email %}
    <a href="{{ site.links.email }}" title="Email" aria-label="Email">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 5.5A1.5 1.5 0 0 1 3.5 4h17A1.5 1.5 0 0 1 22 5.5v13a1.5 1.5 0 0 1-1.5 1.5h-17A1.5 1.5 0 0 1 2 18.5v-13ZM4.6 6l7.4 5.6L19.4 6H4.6ZM20 7.6l-7.4 5.6a1 1 0 0 1-1.2 0L4 7.6V18h16V7.6Z"/></svg>
    </a>
  {% endif %}
  {% if site.links.github %}
    <a href="{{ site.links.github }}" title="GitHub" aria-label="GitHub">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.53 2.36 1.09 2.94.83.09-.65.35-1.09.63-1.34-2.22-.25-4.56-1.11-4.56-4.95 0-1.09.39-1.99 1.03-2.69-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.03a9.5 9.5 0 0 1 5 0c1.91-1.3 2.75-1.03 2.75-1.03.55 1.38.2 2.4.1 2.65.64.7 1.03 1.6 1.03 2.69 0 3.85-2.34 4.7-4.57 4.94.36.31.68.92.68 1.85v2.74c0 .27.18.58.69.48A10 10 0 0 0 12 2Z"/></svg>
    </a>
  {% endif %}
  {% if site.links.linkedin %}
    <a href="{{ site.links.linkedin }}" title="LinkedIn" aria-label="LinkedIn">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9h4v12H3V9Zm6 0h3.8v1.71h.05c.53-.95 1.83-1.96 3.77-1.96C20.5 8.75 22 10.8 22 14.2V21h-4v-6.1c0-1.5-.03-3.44-2.1-3.44-2.1 0-2.42 1.63-2.42 3.32V21H9V9Z"/></svg>
    </a>
  {% endif %}
  {% if site.links.scholar %}
    <a href="{{ site.links.scholar }}" title="Google Scholar" aria-label="Google Scholar">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2 1 8l11 6 9-4.91V17h2V8L12 2ZM5 13.18V17c0 1.66 3.13 3.5 7 3.5s7-1.84 7-3.5v-3.82l-7 3.82-7-3.82Z"/></svg>
    </a>
  {% endif %}
  {% if site.links.twitter %}
    <a href="{{ site.links.twitter }}" title="X" aria-label="X">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231 5.451-6.231Zm-1.161 17.52h1.833L7.084 4.126H5.117l11.966 15.644Z"/></svg>
    </a>
  {% endif %}
  {% if site.cv %}
    <a href="{{ site.cv }}" title="Curriculum Vitae (PDF)" aria-label="Curriculum Vitae PDF">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 2h8l6 6v13a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V3a1 1 0 0 1 1-1Zm7 2H7v16h11V9h-5V4Zm-4 8h6v1.6H9V12Zm0 3.2h6v1.6H9v-1.6Z"/></svg>
    </a>
  {% endif %}
</div>
